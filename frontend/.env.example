# ─────────────────────────────────────────────────────────────────────────────
# BhashaSetu AI — Frontend Environment Variables
# On Vercel: Project → Settings → Environment Variables → add these.
# Locally: copy this file to frontend/.env.local
# ─────────────────────────────────────────────────────────────────────────────

# Your Railway backend URL (fill in after deploying backend)
NEXT_PUBLIC_API_URL=https://your-backend.up.railway.app

# Your Vercel frontend URL (fill in after deploying frontend)
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
